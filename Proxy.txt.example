# Прокси — по одному на строку. Строки с # и пустые игнорируются.
#
# Поддерживаются HTTP/HTTPS-прокси (SOCKS не поддерживается).
# Если схема не указана, бот подставляет http://
#
# Формат 1 (основной): user:pass@host:port
user1:password1@proxy.example.com:10001
user2:password2@proxy.example.com:10002
# Формат 2: со схемой
http://user3:password3@proxy.example.com:10003
# Формат 3: без логина и пароля
203.0.113.10:8080
#
# ВАЖНО: каждый взятый ботом прокси УДАЛЯЕТСЯ из файла — один прокси на один аккаунт
# (даже если регистрация не удалась). Прокси нужно не меньше, чем email'ов.
# Если файл пуст — бот останавливается.
