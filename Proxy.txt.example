# Прокси — по одному на строку, формат: user:pass@host:port
# (можно и со схемой: http://user:pass@host:port или socks5://...).
# ВАЖНО: каждый взятый ботом прокси УДАЛЯЕТСЯ из файла — один прокси на один аккаунт.
# Нужно прокси не меньше, чем email'ов. Если файл пуст — бот остановится.
user1:password1@proxy.example.com:10001
user2:password2@proxy.example.com:10002
user3:password3@proxy.example.com:10003
